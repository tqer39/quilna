{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adaptive-textbook-local",
  "main": "workers/index.mjs",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNTS", "class_name": "AccountVault" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountVault"] }],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "adaptive-textbook-auth",
      "migrations_dir": "migrations/auth",
    },
  ],
  "vars": { "APP_ORIGIN": "http://127.0.0.1:8787" },
  "observability": { "enabled": false },
}
